{
  "dataset": "PowerTradingLab benchmarks",
  "interface_version": 1,
  "publisher": {
    "name": "PowerTradingLab",
    "url": "https://powertradinglab.org"
  },
  "terms": "Free to use with attribution. Derived values only: no day-ahead or imbalance prices are republished here or anywhere else in this dataset.",
  "generated_from": "2026-11-12T10:44:27Z",
  "unit": "EUR per MW of trading capacity, summed over the delivery day",
  "granularity": "one row per zone per delivery day, newest pass only",
  "benchmarks": {
    "passive_da_buy_value": "Buy 1 MW on the day-ahead auction for every PTU of the day and settle the position in imbalance. No foresight: the same side every PTU.",
    "passive_da_sell_value": "Sell 1 MW on the day-ahead auction for every PTU of the day and settle the position in imbalance. No foresight: the same side every PTU.",
    "extractable_value": "The better of the two passive positions, chosen per PTU with perfect hindsight. It can be negative where dual imbalance pricing leaves the day-ahead price inside the penalty band, and that negative is real.",
    "adverse_value": "The worse of the two passive positions, chosen per PTU with perfect hindsight. Where a zone prices imbalance single-sided it is the exact mirror of extractable_value.",
    "trailing_bias_value": "The result of the hourly trailing-bias rule, which picks the day-ahead side from a trailing mean per hour of day and uses only what was known before the auction closed. Empty where no decision was issued."
  },
  "columns": {
    "zone": "Bidding zone code.",
    "delivery_day": "The delivery day in the zone's own market time, ISO date.",
    "ptu": "How many 15-minute periods the day was graded on. Less than a full day means the source published fewer.",
    "ptu_with_action": "How many of those carried a decision of ours. The denominator for trailing_bias_value.",
    "pass": "as-known (graded the morning after delivery) or as-final (regraded after imbalance settled).",
    "calc_iteration": "Which pass this is for this delivery day, counting from 1.",
    "knownby_ts": "The instant the row was computed \u2014 everything in it was knowable then.",
    "source_file": "The frozen published document this row was derived from."
  },
  "forecast_columns": {
    "zone": "Bidding zone code.",
    "delivery_day": "The day the decision is FOR, in the zone's own market time.",
    "knownby_ts": "When the decision was made. Always before the day-ahead gate of the day before delivery_day.",
    "ptu": "15-minute periods in the delivery day (92, 96 or 100).",
    "ptu_buy": "Periods with action +1: buy on the day-ahead auction, settle in imbalance.",
    "ptu_sell": "Periods with action -1: sell on the day-ahead auction, settle in imbalance.",
    "ptu_no_action": "Periods with no action. ptu = ptu_buy + ptu_sell + ptu_no_action, always.",
    "data_through": "The freshest fact the signal saw.",
    "skip_reason": "Empty: where there is no action, the signal did not form. Set: the forecast was REFUSED, and the value says why (kind:missing day[:leg]).",
    "source_file": "The frozen published forecast this row was derived from; per-period actions are there."
  },
  "monthly_granularity": "one row per zone per calendar month: the sums of that zone's daily rows; final once settled, open while running",
  "monthly_columns": {
    "zone": "Bidding zone code.",
    "month": "Calendar month of the delivery days, in the zone's own market time, YYYY-MM.",
    "status": "final: every scored day of the month has had its as-final pass (from the 20th of the following month) - the month is settled and will not move. open: the month so far, a running total that changes every day until it settles.",
    "days_in_month": "Calendar days in the month.",
    "days_scored": "Delivery days with a row in <zone>_scores.csv. Fewer than days_in_month means the source left days out, or the month is still running; a missing day is never filled.",
    "days_with_decision": "Days on which trailing_bias_value carries a decision.",
    "knownby_ts": "The newest instant among the month's rows: everything in the line was knowable then."
  },
